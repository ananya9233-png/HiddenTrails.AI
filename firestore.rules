rules_version = '2';

// HiddenTrails.AI — Firestore security rules
// The backend uses the Admin SDK, which bypasses these rules. They only
// restrict what the browser (Firebase web SDK) can do directly.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore → Rules)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Users ──────────────────────────────────────────────
    // Points, level, completed challenges and coupons are written ONLY by the backend.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'rewardPoints', 'level', 'completedChallenges', 'createdAt'])
        && request.resource.data.rewardPoints == 0
        && request.resource.data.completedChallenges.size() == 0;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      allow delete: if false;

      match /{sub=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ── Trips ──────────────────────────────────────────────
    // Created by the backend; the owner can read, cache images, and delete.
    match /trips/{tripId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['days', 'hero_image']);
      allow create: if false;
    }

    // ── Hidden gems uploaded by users ──────────────────────
    match /pois/{poiId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.verified == false
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000;
      allow update, delete: if false;
    }

    // ── Backend-only collections ───────────────────────────
    match /photoChallenges/{id} { allow read, write: if false; }
    match /gpsLogs/{id}         { allow read, write: if false; }
    match /touristPlaces/{id}   { allow read, write: if false; }
    match /coupons/{id}         { allow read, write: if false; }
  }
}
