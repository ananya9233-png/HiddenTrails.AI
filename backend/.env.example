# Copy this file to backend/.env and fill in your own values.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Secret for the admin panel (admin.html). Use a long random string.
ADMIN_KEY=

# Optional
PORT=5000
# GROQ_TEXT_MODEL=qwen/qwen3.8-27b     # override if Groq retires a model
# GROQ_VISION_MODEL=qwen/qwen3.8-27b   # must accept image input
# NODE_ENV=development          # include stack traces in error responses
# CORS_ORIGINS=http://localhost:5501,http://127.0.0.1:5501
# ALLOW_INSECURE_TLS=true       # only on networks with a TLS-intercepting proxy
